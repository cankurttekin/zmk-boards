#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                25 26 27 28 29
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <120>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24
            >;

            hold-trigger-on-release;
        };
    };

    keymap {

        compatible = "zmk,keymap";

        /* =========================================================
         * BASE
         *
         *  Q W E R T       Y U I O P
         *  A S D F G       H J K L ;
         *  Z X C V B       N M , . /
         *
         *       NUM SPC TAB   ENT BSP NAV
         * ========================================================= */

        base {
            display-name = "Base";

            bindings = <
                &kp Q           &kp W           &kp E
                &kp R           &kp T           &kp Y
                &kp U           &kp I           &kp O
                &kp P

                &hml LGUI A     &hml LALT S     &hml LCTRL D
                &hml LSHFT F    &kp G           &kp H
                &hmr RSHFT J    &hmr RCTRL K    &hmr RALT L
                &hmr RGUI SEMICOLON

                &kp Z           &kp X           &kp C
                &kp V           &kp B           &kp N
                &kp M           &kp COMMA       &kp DOT
                &kp SLASH

                &mo 1           &kp SPACE       &kp TAB
                &kp ENTER       &kp BACKSPACE  &mo 2
            >;
        };


        /* =========================================================
         * NUM / SYMBOL
         *
         *  ! @ # $ %       ^ & * ( )
         *  1 2 3 4 5       6 7 8 9 0
         *  ` - = [ ]       { } \ ; :
         *
         *       BASE SPC     ENT BSP SYM
         * ========================================================= */

        num {
            display-name = "Num";

            bindings = <
                &kp LS(EXCL)    &kp LS(AT)      &kp LS(POUND)
                &kp LS(DLLR)    &kp LS(PRCNT)  &kp LS(CARET)
                &kp LS(AMPS)    &kp LS(STAR)   &kp LS(LPAR)
                &kp LS(RPAR)

                &kp N1          &kp N2          &kp N3
                &kp N4          &kp N5          &kp N6
                &kp N7          &kp N8          &kp N9
                &kp N0

                &kp GRAVE       &kp MINUS      &kp EQUAL
                &kp LEFT_BRACKET &kp RIGHT_BRACKET
                &kp LBRC        &kp RBRC        &kp BACKSLASH
                &kp SEMICOLON   &kp COLON

                &trans           &kp SPACE       &kp TAB
                &kp ENTER        &kp BACKSPACE  &mo 2
            >;
        };


        /* =========================================================
         * NAV / SYM
         *
         *  ESC [ ] { }       HOME PGUP UP PGDN END
         *  TAB ( ) < >       LEFT DOWN UP RIGHT DEL
         *  --- --- ---       PREV PLAY NEXT
         *
         *       BASE VOL-     VOL+ BSP EXTRA
         * ========================================================= */

        nav {
            display-name = "Nav";

            bindings = <
                &kp ESCAPE       &kp LEFT_BRACKET &kp RIGHT_BRACKET
                &kp LBRC         &kp RBRC         &kp HOME
                &kp PAGE_UP      &kp UP           &kp PAGE_DOWN
                &kp END

                &kp TAB          &kp LPAR         &kp RPAR
                &kp LT           &kp GT           &kp LEFT
                &kp DOWN         &kp UP           &kp RIGHT
                &kp DELETE

                &kp GRAVE        &kp MINUS       &kp EQUAL
                &kp UNDERLINE    &kp BACKSLASH   &kp C_PREVIOUS
                &kp C_PLAY_PAUSE &kp C_NEXT      &kp C_STOP

                &trans           &kp C_VOLUME_DOWN &kp C_BRI_DEC
                &kp C_VOLUME_UP  &kp BACKSPACE    &mo 3
            >;
        };


        /* =========================================================
         * EXTRA
         *
         *  F1 F2 F3 F4 F5       F6 F7 F8 F9 F10
         *  F11 F12 PRINT LOCK    BT PREV/SEL/NEXT
         *  RESET BOOT STUDIO     USB BLE
         *
         *       BASE SPC         ENT BSP BASE
         * ========================================================= */

        extra {
            display-name = "Extra";

            bindings = <
                &kp F1          &kp F2          &kp F3
                &kp F4          &kp F5          &kp F6
                &kp F7          &kp F8          &kp F9
                &kp F10

                &kp F11         &kp F12         &kp PRINTSCREEN
                &kp CAPSLOCK    &bt BT_CLR      &bt BT_SEL 0
                &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
                &bt BT_SEL 4

                &sys_reset      &bootloader     &studio_unlock
                &out OUT_USB     &out OUT_BLE    &kp C_SLEEP
                &kp K_APPLICATION &kp C_BRIGHTNESS_DEC
                &kp C_BRIGHTNESS_INC &kp K_MUTE

                &trans           &kp SPACE       &kp TAB
                &kp ENTER        &kp BACKSPACE  &trans
            >;
        };
    };
};
