#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            // Right-hand keys.

            hold-trigger-key-positions = <
                6  7  8  9  10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                42 43 44 45 46 47
                52 53 54 55
                58 59
                62 63 67
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <120>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            // Left-hand keys.

            hold-trigger-key-positions = <
                0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                48 49 50 51
                56 57
                60 61 64 65 66
            >;

            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp EQUAL       &kp N1       &kp N2            &kp N3             &kp N4         &kp N5                                  &kp N6         &kp N7        &kp N8         &kp N9       &kp N0               &kp GRAVE
&kp TAB         &kp Q        &kp W             &kp E              &kp R          &kp T                                   &kp Y          &kp U         &kp I          &kp O        &kp P                &kp BACKSLASH
&kp ESCAPE      &hml LGUI A  &hml LALT S       &hml LSHIFT D      &hml LCTRL F   &kp G                                   &kp H          &hmr RCTRL J  &hmr LSHIFT K  &hmr RALT L  &hmr RGUI SEMICOLON  &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z        &kp X             &kp C              &kp V          &kp B                                   &kp N          &kp M         &kp COMMA      &kp DOT      &kp SLASH            &kp RIGHT_SHIFT
&kp LEFT        &kp RIGHT    &kp LEFT_BRACKET  &kp RIGHT_BRACKET                                                                                      &kp MINUS      &kp EQUAL    &kp UP               &kp DOWN
                                                                  &kp BACKSPACE  &kp DELETE                              &kp SPACE      &kp ENTER
                                                                                 &mo 2       &kp LEFT_GUI  &kp LEFT_ALT  &kp RIGHT_GUI
                                                                                 &kp HOME    &kp LCTRL     &mo 1         &kp END
            >;
        };

        layer1 {
            bindings = <
&trans     &trans        &trans      &trans         &trans        &trans                         &kp RBKT       &trans        &trans        &trans        &trans        &trans
&kp GRAVE  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)                  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&kp F12    &kp N1        &kp N2      &kp N3         &kp N4        &kp N5                         &kp N6         &kp N7        &kp N8        &kp N9        &kp N0        &kp F11
&trans     &kp F1        &kp F2      &kp F3         &kp F4        &kp F5                         &kp F6         &kp F7        &kp F8        &kp F9        &kp F10       &trans
&trans     &trans        &trans      &trans                                                                                   &trans        &trans        &trans        &kp PRINTSCREEN
                                                    &trans        &trans                         &trans         &trans
                                                                  &trans         &trans  &trans  &trans
                                                                  &mo 3          &trans  &trans  &trans
            >;
        };

        layer2 {
            bindings = <
&kp F12        &kp F1       &kp F2  &kp F3    &kp F4     &kp F5                  &kp F6             &kp F7           &kp F8            &kp F9                &kp F10            &kp F11
&trans         &trans       &trans  &trans    &trans     &trans                  &trans             &trans           &trans            &trans                &trans             &trans
&trans         &kp LEFT     &kp UP  &kp DOWN  &kp RIGHT  &trans                  &trans             &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT            &trans             &trans
&trans         &trans       &trans  &trans    &trans     &trans                  &kp C_SLEEP        &kt K_MUTE       &trans            &trans                &trans             &trans
&kp PAGE_DOWN  &kp PAGE_UP  &trans  &trans                                                                           &kp C_BRI_DEC     &kp C_BRIGHTNESS_INC  &kp K_APPLICATION  &kp CAPSLOCK
                                              &trans     &trans                  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
                                                         &trans  &trans  &trans  &trans
                                                         &trans  &trans  &trans  &mo 3
            >;
        };

        conflayer {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &none  &none  &none  &none  &none  &none
&none  &none         &out OUT_USB    &none         &sys_reset    &none                       &none  &none  &none  &none  &none  &none
&none  &none         &studio_unlock  &none         &bootloader   &none                       &none  &none  &none  &none  &none  &none
&none  &none         &none           &bt BT_CLR    &none         &out OUT_BLE                &none  &none  &none  &none  &none  &none
&none  &none         &none           &none                                                                 &none  &none  &none  &none
                                                   &none         &none                       &none  &none
                                                                 &none         &none  &none  &none
                                                                 &none         &none  &none  &none
            >;
        };
    };
};
