#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            // Right-hand keys.
            hold-trigger-key-positions = <
                6  7  8  9  10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                42 43 44 45 46 47
                52 53 54 55
                58 59
                62 63 67
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <120>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            // Left-hand keys.
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                48 49 50 51
                56 57
                60 61 64 65 66
            >;

            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ============================================================
         * BASE
         *
         *             Q W E R T       Y U I O P
         *             A S D F G       H J K L ;
         *             Z X C V B       N M , . /
         *
         *                   NUM SPC   ENT NAV
         *
         * ============================================================
         */

        layer0 {
            bindings = <
                &none         &none         &none         &none         &none         &none
                &none         &kp Q         &kp W         &kp E         &kp R         &kp T
                &none         &hml LGUI A   &hml LALT S   &hml LCTRL D   &hml LSHFT F  &kp G
                &none         &kp Z         &kp X         &kp C         &kp V         &kp B

                &none         &none         &none         &none         &none         &none
                &kp Y         &kp U         &kp I         &kp O         &kp P         &none
                &kp H         &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L   &hmr RGUI SEMICOLON &none
                &kp N         &kp M         &kp COMMA     &kp DOT       &kp SLASH     &none

                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
                &mo 1         &kp SPACE     &kp TAB       &kp ENTER      &kp BACKSPACE  &mo 2
                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
            >;
        };


        /*
         * ============================================================
         * NUM
         *
         *             ! @ # $ %       ^ & * ( )
         *             1 2 3 4 5       6 7 8 9 0
         *             - = [ ] \       { } ; :
         *
         *                    BASE SPC  ENT SYM
         * ============================================================
         */

        layer1 {
            bindings = <
                &none         &none         &none         &none         &none         &none
                &none         &kp LS(EXCL)  &kp LS(AT)    &kp LS(POUND) &kp LS(DLLR)   &kp LS(PRCNT)
                &none         &kp N1        &kp N2        &kp N3        &kp N4        &kp N5
                &none         &kp MINUS     &kp EQUAL     &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp BACKSLASH

                &none         &none         &none         &none         &none         &none
                &kp LS(CARET) &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)   &kp LS(RPAR)  &none
                &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &none
                &kp LBRC      &kp RBRC      &kp SEMICOLON  &kp COLON      &kp SLASH     &none

                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
                &trans        &kp SPACE     &kp TAB       &kp ENTER      &kp BACKSPACE  &mo 2
                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
            >;
        };


        /*
         * ============================================================
         * SYM / NAV
         *
         *             ESC [ ] { }       HOME PGUP UP PGDN END
         *             TAB ( ) < >       LEFT DOWN UP RIGHT DEL
         *             --- --- ---       PREV PLAY NEXT
         *
         *                   BASE VOL-   VOL+ BSP EXTRA
         * ============================================================
         */

        layer2 {
            bindings = <
                &none         &none         &none         &none         &none         &none
                &none         &kp ESCAPE    &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_BRACE &kp RIGHT_BRACE
                &none         &kp TAB       &kp LPAR       &kp RPAR       &kp LT        &kp GT
                &none         &kp GRAVE     &kp MINUS     &kp EQUAL      &kp BACKSLASH  &kp UNDERSCORE

                &none         &none         &none         &none         &none         &none
                &kp HOME      &kp PAGE_UP   &kp UP         &kp PAGE_DOWN  &kp END       &none
                &kp LEFT      &kp DOWN      &kp UP         &kp RIGHT      &kp DELETE    &none
                &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT  &kp C_VOLUME_DOWN &kp C_VOLUME_UP &none

                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
                &trans        &kp C_VOLUME_DOWN &kp C_BRI_DEC &kp C_VOLUME_UP &kp BACKSPACE &mo 3
                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
            >;
        };


        /*
         * ============================================================
         * EXTRA
         *
         *             F1 F2 F3 F4 F5       F6 F7 F8 F9 F10
         *             F11 F12 PRINT CAPS    BT0 BT1 BT2 BT3 BT4
         *
         *             RESET BOOT STUDIO     USB BLE SLEEP MUTE
         *
         * ============================================================
         */

        layer3 {
            bindings = <
                &none         &none         &none         &none         &none         &none
                &none         &kp F1        &kp F2        &kp F3        &kp F4        &kp F5
                &none         &kp F11       &kp F12       &kp PRINTSCREEN &kp CAPSLOCK  &bt BT_SEL 0
                &none         &sys_reset    &bootloader   &studio_unlock &out OUT_USB  &out OUT_BLE

                &none         &none         &none         &none         &none         &none
                &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &none
                &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &none
                &kp C_SLEEP   &kp K_APPLICATION &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &kp K_MUTE &none

                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
                &trans        &kp SPACE     &kp TAB       &kp ENTER      &kp BACKSPACE  &trans
                &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none
            >;
        };
    };
};
