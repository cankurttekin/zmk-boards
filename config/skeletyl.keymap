#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <120>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
            >;

            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P
                &hml LGUI A    &hml LALT S    &hml LCTRL D   &hml LSHFT F   &kp G          &kp H          &hmr RSHFT J   &hmr RCTRL K   &hmr RALT L    &hmr RGUI SEMICOLON
                &kp Z          &kp X          &kp C          &kp V          &kp B          &kp N          &kp M          &kp COMMA      &kp DOT        &kp SLASH
                                      &mo 1         &kp TAB       &kp SPACE      &kp ENTER      &mo 2         &kp BACKSPACE
            >;
        };

        lower {
            bindings = <
                &kp ESC        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9
                &kp TAB        &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &kp N0
                &kp GRAVE      &kp BSLH       &kp SEMICOLON  &kp APOS       &kp COMMA      &kp HOME       &kp PG_DN      &kp PG_UP      &kp END        &kp SLASH
                                      &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        raise {
            bindings = <
                &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7           &kp F8         &kp F9         &kp F10
                &kp F11        &kp F12        &kp PSCRN      &kp CAPS       &kp K_APP      &kp C_PREV     &kp C_PLAY_PAUSE &kp C_NEXT     &kp K_MUTE     &kp C_VOL_DN
                &kp C_BRI_DN   &kp C_BRI_UP   &kp C_VOL_UP   &kp C_STOP     &kp K_CANCEL   &kp INSERT     &kp DELETE       &kp HOME       &kp END        &kp ESC
                                      &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        conflayer {
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none          &none            &none          &none          &none
                &none          &studio_unlock &none          &bootloader    &sys_reset     &none          &none            &none          &none          &none
                &out OUT_USB   &out OUT_BLE   &bt BT_CLR     &none          &none          &none          &none            &none          &none          &none
                                      &none         &none         &none         &none         &none         &none
            >;
        };
    };
};
